generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  head
  coo
  manager
  caller
  customer_service
}

enum AccountStatus {
  New
  Working
  PTP
  Part_paid
  Closed
  Settled
}

enum SettlementStatus {
  Pending
  Approved
  Rejected
}

enum ClosureType {
  Settlement
  Closure
}

model Office {
  id        String @id @default(cuid())
  name      String @unique
  users     User[]
  accounts  Account[]
}

model User {
  id        String @id
  name      String
  username  String @unique
  password  String
  role      Role
  officeId  String
  office    Office @relation(fields: [officeId],references: [id])
  managerId String?
  manager   User? @relation("Team",fields: [managerId], references: [id])
  callers     User[]   @relation("Team")
  accounts    Account[] @relation("CurrentOwner")
  allocations         Allocation[] @relation("AllocationAssignee")
  previousAllocations Allocation[] @relation("AllocationPreviousOwner")
  createdAllocations  Allocation[] @relation("AllocationActor")
  calls       CallLog[]
  promises    PTP[]
  payments    Payment[]
  settlementRequests SettlementOffer[] @relation("SettlementRequester")
  settlementReviews SettlementOffer[] @relation("SettlementReviewer")
  notifications Notification[]
  createdAt   DateTime @default(now())
}

model Account {
  loanNo           String        @id
  portfolio        String
  sellerBank       String
  customerName     String
  mobile           String
  email            String?
  city             String
  state            String
  officeId         String
  office           Office        @relation(fields: [officeId], references: [id])
  language         String
  product          String
  originalAmount   Decimal       @db.Decimal(14, 2)
  outstanding      Decimal       @db.Decimal(14, 2)
  npaDate          DateTime?
  lastPaymentDate  DateTime?
  status           AccountStatus @default(New)
  assignedToId     String?
  assignedTo       User?         @relation("CurrentOwner", fields: [assignedToId], references: [id])
  allocations      Allocation[]
  calls            CallLog[]
  promises         PTP[]
  payments         Payment[]
  settlements      SettlementOffer[]
  notifications    Notification[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([customerName])
  @@index([mobile])
  @@index([assignedToId, status])
  @@index([officeId, status])
}

model Allocation {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [loanNo], onDelete: Cascade)
  userId      String
  user        User     @relation("AllocationAssignee", fields: [userId], references: [id])
  allocatedBy String
  allocator   User     @relation("AllocationActor", fields: [allocatedBy], references: [id])
  fromUserId  String?
  fromUser    User?    @relation("AllocationPreviousOwner", fields: [fromUserId], references: [id], onDelete: SetNull)
  allocatedAt DateTime @default(now())

  @@index([accountId, allocatedAt])
}

model CallLog {
  id           String   @id @default(cuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [loanNo], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  disposition  String
  remarks      String?
  followUpAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([accountId, createdAt])
}

model PTP {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [loanNo], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Decimal  @db.Decimal(14, 2)
  dueDate   DateTime
  status    String   @default("Pending")
  createdAt DateTime @default(now())

  @@index([dueDate, status])
}

model Payment {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [loanNo], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amount      Decimal  @db.Decimal(14, 2)
  paidAt      DateTime @default(now())
  reference   String?
  notes       String?

  @@index([accountId, paidAt])
}

model SettlementOffer {
  id          String           @id @default(cuid())
  accountId   String
  account     Account          @relation(fields: [accountId], references: [loanNo], onDelete: Cascade)
  amount      Decimal          @db.Decimal(14, 2)
  type        ClosureType      @default(Settlement)
  status      SettlementStatus @default(Pending)
  requestedById String
  requestedBy User             @relation("SettlementRequester", fields: [requestedById], references: [id])
  reviewedById String?
  reviewedBy  User?            @relation("SettlementReviewer", fields: [reviewedById], references: [id])
  reviewedAt  DateTime?
  createdAt   DateTime         @default(now())

  @@index([accountId, status])
}

model Notification {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String
  account           Account  @relation(fields: [accountId], references: [loanNo], onDelete: Cascade)
  settlementOfferId String
  title             String
  message           String
  readAt            DateTime?
  createdAt         DateTime @default(now())

  @@index([userId, readAt, createdAt])
  @@index([accountId])
}
